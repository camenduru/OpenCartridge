[
  {
    "home": true,
    "id": "idol",
    "name": "Idol 3D",
    "description": "One image in, a 3D model out: Idol predicts the whole object — including the sides the photo never showed — as a gaussian splat, and the cartridge meshes it and returns a GLB.",
    "category": "3d",
    "icon": "Box",
    "inputTypes": [
      "image"
    ],
    "workerId": "",
    "cost": "0",
    "processingTime": "90",
    "delay": "12000",
    "overview": "Idol (Speridlabs) is the TripoSplat architecture retrained on single-object photographs, so ComfyUI runs it natively: DINOv3 ViT-H features and the FLUX.2 VAE condition the denoiser, 50 Euler steps denoise the object's shape code plus the camera token, and the octree/gaussian decoder expands that into a gaussian splat. This cartridge cuts the object out with BiRefNet, crops it Idol's way, drops the near-transparent gaussians that only add haze, meshes the splat and returns the GLB — which the canvas orbits in its 3D viewer.",
    "divisible": 32,
    "inputs": [
      {
        "name": "input_image",
        "accepts": [
          "image/*"
        ],
        "bind": "primary",
        "required": true
      }
    ],
    "returns": {
      "type": "model/gltf-binary",
      "ext": "glb",
      "layer": "3d"
    },
    "examples": {
      "input": [
        "https://examples.tost.ai/f43f435tgrfsd.jpg"
      ],
      "output": [
        "https://huggingface.co/camenduru/glb/resolve/main/f43f435tgrfsd.glb"
      ]
    },
