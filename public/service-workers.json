[
  {
    "id": "3x3-sprite-sheet",
    "name": "3x3 Sprite Sheet",
    "catalog": "services/3x3-sprite-sheet.json",
    "apiUrl": "http://host.docker.internal:8000",
    "uploadUrl": "http://localhost:9000",
    "workerUploadUrl": "http://host.docker.internal:9000",
    "container": {
      "name": "3x3-sprite-sheet",
      "image": "camenduru/3x3-sprite-sheet:latest",
      "port": 8000,
      "hostPort": 8000,
      "gpus": true,
      "ulimits": { "memlock": 67108864 },
      "command": ["python", "worker_runpod.py", "--rp_serve_api", "--rp_api_port", "8000", "--rp_api_host", "0.0.0.0", "--rp_log_level", "DEBUG", "--rp_debugger"],
      "env": {
        "s3_access_key_id": "${s3_access_key_id}",
        "s3_secret_access_key": "${s3_secret_access_key}",
        "s3_endpoint_url": "http://host.docker.internal:9000",
        "s3_region_name": "us-east-1",
        "s3_bucket_name": "tost",
        "s3_bucket_folder": "output"
      }
    }
  },
